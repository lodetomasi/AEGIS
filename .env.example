# AETHER Configuration Example
# Copy this file to .env and fill in your values

# OpenRouter API Key (required)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional settings
# Cache directory (default: ./data/cache)
AETHER_CACHE_DIR=./data/cache

# Cache TTL in hours (default: 24)
AETHER_CACHE_TTL=24

# Default models for evaluation (comma-separated)
AETHER_DEFAULT_MODELS=mistral-7b-instruct,llama-3-8b

# Log level (DEBUG, INFO, WARNING, ERROR)
AETHER_LOG_LEVEL=INFO