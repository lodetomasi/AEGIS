{
  "model": "gpt-4",
  "version": "1.0.0",
  "created_by": "AETHER Team",
  "temperature": 0.7,
  "max_tokens": 2048,
  "system_prompt": "You are a helpful AI assistant designed to assist users with various tasks while maintaining safety and accuracy.",
  
  "models": [
    {
      "name": "gpt-4",
      "version": "latest",
      "provider": "openai",
      "parameters": {
        "temperature": 0.7,
        "top_p": 0.95,
        "frequency_penalty": 0.0,
        "presence_penalty": 0.0
      },
      "capabilities": [
        "text_generation",
        "reasoning",
        "code_generation",
        "conversation"
      ],
      "limitations": [
        "training_cutoff",
        "hallucination_risk",
        "context_window"
      ]
    }
  ],
  
  "tools": [
    {
      "name": "web_search",
      "description": "Search the web for information",
      "permissions": ["internet_access"],
      "parameters": {
        "max_results": 10,
        "safe_search": true
      },
      "risk_level": "medium"
    },
    {
      "name": "calculator",
      "description": "Perform mathematical calculations",
      "permissions": [],
      "parameters": {
        "precision": 10
      },
      "risk_level": "low"
    },
    {
      "name": "file_reader",
      "description": "Read files from allowed directories",
      "permissions": ["file_read"],
      "parameters": {
        "allowed_paths": ["/tmp", "/data/public"],
        "max_file_size": 10485760
      },
      "risk_level": "medium"
    },
    {
      "name": "database_query",
      "description": "Query read-only database",
      "permissions": ["db_read"],
      "parameters": {
        "allowed_tables": ["products", "categories"],
        "max_rows": 1000
      },
      "risk_level": "medium"
    }
  ],
  
  "permissions": {
    "internet_access": true,
    "file_read": true,
    "file_write": false,
    "code_execution": false,
    "system_access": false,
    "db_read": true,
    "db_write": false,
    "api_access": true,
    "email_access": false
  },
  
  "data_access": [
    "database:products_readonly",
    "file:/data/public/*",
    "api:weather_service",
    "api:news_aggregator"
  ],
  
  "api_access": [
    "https://api.weather.com/v1/*",
    "https://newsapi.org/v2/*"
  ],
  
  "workflow": [
    {
      "name": "input_validation",
      "type": "validate",
      "parameters": {
        "check_injection": true,
        "sanitize_html": true
      }
    },
    {
      "name": "process_request",
      "type": "process",
      "parallel": false
    },
    {
      "name": "output_filtering",
      "type": "filter",
      "parameters": {
        "remove_pii": true,
        "check_harmful": true
      }
    }
  ],
  
  "dependencies": {
    "model:gpt-4": ["tool:web_search", "tool:calculator"],
    "tool:database_query": ["tool:output_filtering"]
  },
  
  "metadata": {
    "deployment_env": "production",
    "compliance": ["GDPR", "CCPA"],
    "security_features": [
      "input_validation",
      "output_filtering",
      "rate_limiting",
      "audit_logging"
    ],
    "monitoring": {
      "metrics_enabled": true,
      "log_level": "INFO",
      "alert_thresholds": {
        "error_rate": 0.05,
        "response_time": 5000
      }
    }
  }
}